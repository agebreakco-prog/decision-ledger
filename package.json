{
  "name": "decision-ledger",
  "version": "1.0.0",
  "description": "Decision Ledger: a Forge app for Confluence + Jira with a Rovo agent and MCP tools that captures team decisions and flags work that contradicts them.",
  "private": true,
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "test": "node --no-warnings --experimental-test-module-mocks --test test/*.test.js",
    "lint": "forge lint",
    "lint:offline": "node scripts/offline-lint.cjs",
    "check": "npm test && node scripts/offline-lint.cjs",
    "deploy": "forge deploy",
    "tunnel": "forge tunnel"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/kvs": "^2.1.2",
    "@forge/react": "^12.5.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@forge/cli": "^14.2.0"
  }
}
